# SITE_MODE and production publication values are consumed during the image
# build and again at runtime. Production values must exactly match the values
# baked into the deployed image.

# The default and safest local mode. Prototype pages stay noindex, use an empty
# sitemap, and emit no entity JSON-LD.
SITE_MODE=prototype

# Illustrative public-domain format only. Replace both hostnames with the same
# approved production hostname. Production also requires a complete verified
# site identity; content and products use their own evidence records.
# SITE_MODE=production
# SITE_URL=https://store.tideform.com
# APPROVED_PRODUCTION_DOMAIN=store.tideform.com
# SITE_EVIDENCE_GATE=approved
# After `cosign verify` succeeds for container.yml@refs/heads/main and the exact digest:
# SIGNATURE_VERIFIED_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Legacy compatibility only. When set in production, it must exactly equal
# SITE_URL.
# NEXT_PUBLIC_SITE_URL=https://store.tideform.com

# Deployment smoke test only. Set this in the server runtime env file, not as a
# Docker build argument.
# PUBLIC_BASE_URL=https://store.tideform.com

# Deployment secrets do not belong in this file or in Git. Keep the GHCR token
# in /opt/tideform/config/registry-auth.json (mode 600). Pass IMAGE with an
# explicit tag or digest to the deployment script; production requires a
# digest that equals SIGNATURE_VERIFIED_DIGEST. Do not store IMAGE here.

# Optional Playwright target when tests should use an already running server.
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
